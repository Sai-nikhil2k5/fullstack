<h3>{{viewTitle}}</h3>

<form action="/ludent" method="POST" autocomplete="off">
    <input type="hidden" name="_id" value="{{ludent._id}}">
    
    <div class="mb-3 text-start">
        <label class="form-label">Full Name</label>
        <input type="text" class="form-control" name="fullName" placeholder="Full Name" value="{{ludent.fullName}}" required>
    </div>
    
    <div class="mb-3 text-start">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" name="email" placeholder="Email" value="{{ludent.email}}" required>
    </div>
    
    <div class="row g-3 mb-3 text-start">
        <div class="col-md-6">
            <label class="form-label">Mobile</label>
            <input type="text" class="form-control" name="mobile" placeholder="Mobile number" value="{{ludent.mobile}}" required>
        </div>
        <div class="col-md-6">
            <label class="form-label">City</label>
            <input type="text" class="form-control" name="city" placeholder="City name" value="{{ludent.city}}" required>
        </div>
    </div>
    
    <div class="d-flex gap-2 justify-content-center mt-4">
        <button type="submit" class="btn btn-primary"><i class="fa fa-database"></i> Submit</button>
        <a class="btn btn-secondary" href="/ludent/list"><i class="fa fa-list-alt"></i> View All</a>
    </div>
</form>